# Copy this file to backend/.env (and adjust as needed). Never commit the real .env.

# Postgres connection used by Prisma (backend/.env)
DATABASE_URL="postgresql://parttime:parttime_dev_pw@localhost:5432/parttime_jobs?schema=public"

# JWT
JWT_SECRET="generate-your-own-random-secret-do-not-reuse-this-example"
JWT_EXPIRES_IN="7d"

# Backend server
PORT=4000

# Frontend (frontend/.env.local)
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Seed admin account (backend/.env) — change before any real deployment
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="Admin@12345"
